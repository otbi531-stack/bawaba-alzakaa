rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'otbi531@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // ملف كل مستخدم: يقرؤه ويعدّله صاحبه فقط
    match /parents/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if signedIn() && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/blocked/$(uid));
      allow delete: if isAdmin();
    }

    // الحسابات المحذوفة من الإدارة: لا يمكنها الدخول مرة أخرى
    match /blocked/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // طلبات شراء النجوم: ينشئها المستخدم، ويوافق عليها المدير فقط
    match /requests/{rid} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.applied == false;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt']))
        || (signedIn() && resource.data.uid == request.auth.uid
          && resource.data.status == 'approved' && resource.data.applied == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applied']));
      allow delete: if isAdmin();
    }

    function pid(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function isFriend(other) {
      return exists(/databases/$(database)/documents/friendships/$(pid(request.auth.uid, other)));
    }

    // أكواد الدعوة: كل كود يُحجز مرة واحدة لصاحبه
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    // بطاقة اللاعب (الاسم والصورة والنجوم): يراها صاحبها وأصدقاؤه فقط
    match /players/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isFriend(uid));
      allow write: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // الصداقات: يراها ويحذفها طرفاها فقط
    match /friendships/{fid} {
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users.size() == 2
        && fid == pid(request.resource.data.users[0], request.resource.data.users[1]);
      allow read, delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // الرسائل الجاهزة والتحديات: بين الأصدقاء فقط
    match /messages/{mid} {
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && isFriend(request.resource.data.to);
      allow read: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow update: if signedIn() && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'done']);
      allow delete: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }

    // دوري الأسبوع: يراه كل المسجّلين، وكل لاعب يكتب نتيجته فقط
    match /league/{id} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.week + '_' + request.auth.uid
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0 && request.resource.data.xp <= 3000;
      allow delete: if isAdmin();
    }
  }
}
